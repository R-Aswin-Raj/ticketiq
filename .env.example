# ---------------------------------------------------------------------------
# LLM backend. This single variable switches the whole service.
#   mock  = offline deterministic stub (default; used by tests and CI)
#   local = Ollama on OLLAMA_BASE_URL
#   cloud = OpenAI-compatible API on CLOUD_BASE_URL
# ---------------------------------------------------------------------------
LLM_MODE=local

# --- local (Ollama) --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- cloud -----------------------------------------------------------------
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini
CLOUD_API_KEY=

LLM_TIMEOUT_S=30

# --- Reinforcement learning ------------------------------------------------
BANDIT_EPSILON=0.15
BANDIT_STRATEGY=epsilon_greedy     # or ucb1
BANDIT_OPTIMISTIC_INIT=0.0

# --- Retrieval -------------------------------------------------------------
RAG_BACKEND=tfidf                  # or dense
EMBEDDING_BACKEND=hashing          # or sentence-transformers (needs RAG_BACKEND=dense)
CHUNK_SIZE_CHARS=480
CHUNK_OVERLAP_CHARS=80

# --- Storage ---------------------------------------------------------------
# DATA_DIR=./data
